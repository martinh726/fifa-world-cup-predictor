# Copy this file to .env and fill in your API keys

# Get a free key at https://www.football-data.org/
FOOTBALL_DATA_API_KEY=

# Optional: get exact match clock from API-Football (RapidAPI)
APIFOOTBALL_API_KEY=

# Squad quality adjustment strength (0.0 to 0.50, default 0.18)
SQUAD_STRENGTH=0.18

# Backend port
PORT=8000
