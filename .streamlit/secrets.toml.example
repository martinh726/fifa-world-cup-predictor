# Copy this file to .streamlit/secrets.toml and fill in your keys.

# football-data.org — scores, finished matches, Live Tracker sync
# Free tier at https://www.football-data.org/ (10 req/min)
[football_data]
api_key = "paste_your_key_here"

# API-Football — exact live match clock (optional)
# Free tier: 100 req/day. Sign up at https://api-sports.io → API Football → Dashboard
# Without this key the clock shows an estimate (~) instead of exact minutes.
[apifootball]
api_key = "paste_your_apisports_key_here"
